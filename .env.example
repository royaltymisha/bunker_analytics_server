# Railway подставляет DATABASE_URL сам, когда в проекте есть Postgres.
# Локально — строка от локального Postgres или Public Networking URL из Railway.
DATABASE_URL=postgresql://postgres:password@localhost:5432/bunker_analytics

# Тот же ключ прошит в AnalyticsSettings в Unity. Не секрет в криптографическом
# смысле (лежит в билде), но отсекает случайный мусор и ботов.
INGEST_KEY=change-me-ingest

# Ключ для чтения статистики через /v1/stats/*. В клиент НЕ попадает.
ADMIN_KEY=change-me-admin

# Steam Web API key из https://steamcommunity.com/dev/apikey — нужен только для
# серверной проверки билетов (steam_verified). Без него SteamID пишется как есть.
STEAM_WEB_API_KEY=
STEAM_APP_ID=480

# Railway задаёт PORT сам, локально по умолчанию 3000.
PORT=3000
